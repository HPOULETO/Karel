# Projet : Karel le connard
definir tourner_droite:
    tourner_gauche
    tourner_gauche
    tourner_gauche
definir tout_ramasser_sur_une_ligne_connard_et_fait_pas_chier:
    tant que balise_ici:
        ramasser_balise
    tant que devant_libre:
        avancer
        tant que balise_ici:
            ramasser_balise
        

definir ligne_changer:
    si regarde_est:
        si gauche_libre:
            tourner_gauche
            avancer
            tant que balise_ici:
                ramasser_balise
            tourner_gauche
    sinon:
        si droite_libre:
            tourner_droite
            avancer
            tant que balise_ici:
                ramasser_balise
            tourner_droite

definir aller_dans_un_coin:
    tant que pas regarde_sud:
        tourner_gauche
    tant que devant_libre:
        tant que balise_ici:
            ramasser_balise
        avancer
    tourner_droite
    tant que devant_libre:
        tant que balise_ici:
            ramasser_balise
        avancer
    tant que pas regarde_est:
        tourner_gauche

aller_dans_un_coin
repeter 5 fois:
    tout_ramasser_sur_une_ligne_connard_et_fait_pas_chier
    ligne_changer



